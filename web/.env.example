# --- Optional: only needed for "On-chain" mode (after deploying the contract) ---
# Shows the On-chain toggle in the UI.
NEXT_PUBLIC_CHAIN_ENABLED=true

# Server-side only (NEVER prefix with NEXT_PUBLIC_). This is the MRV oracle wallet:
# a fresh, test-only wallet that holds the VERIFIER role on the contract.
VERIFIER_PRIVATE_KEY=
RPC_URL=https://sepolia.base.org

# Set to "false" in production to disable the demo-only "simulate deforestation" hook.
ALLOW_SIMULATED_LOSS=true
