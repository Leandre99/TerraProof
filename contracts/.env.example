# Copy to .env and fill in. NEVER commit .env and NEVER use a wallet that holds real funds.
# Use a fresh, test-only wallet funded from a faucet.
DEPLOYER_PRIVATE_KEY=
# Optional: separate wallet used by the MRV oracle (defaults to the deployer)
VERIFIER_ADDRESS=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# Optional quorum: comma-separated extra verifier wallets and how many must agree (default 1)
EXTRA_VERIFIERS=
THRESHOLD=1
